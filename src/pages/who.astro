---
import '../styles/fraunces.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import RoomNerve from '../components/RoomNerve.astro';
import RoomShell from '../components/RoomShell.astro';

const steps = [
  {
    title: 'Networks and people',
    text: 'I started in technical data analysis and incident operations for enterprise networks, working between customers and engineers across Europe and Asia, where reliability had to hold under pressure.',
  },
  {
    title: 'Architecture',
    text: 'A different kind of systems thinking: how parts fit, how people move through spaces, and how a plan meets real constraints.',
  },
  {
    title: 'Trust and AI quality',
    text: 'Trust and Safety, process optimization, and human-in-the-loop AI across multilingual teams. The work made feedback matter: a quality initiative raised KPIs by 15 points.',
  },
  {
    title: 'Governance',
    text: 'Today, as D&T Global Data Governance Lead at dsm-firmenich, I help turn policies into daily practice: clear ownership, trusted data, accountable AI.',
  },
];

const beliefs = [
  { n: '01', k: 'Enable', t: 'Good governance should enable, not merely mandate.' },
  { n: '02', k: 'Meaning', t: 'People negotiate meaning. Systems should make that meaning usable.' },
  { n: '03', k: 'Accountability', t: 'AI can assist a decision. It cannot take responsibility for its consequences.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Who · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <RoomNerve current="/who" heading={false} />
    <RoomShell title="Who" italic="still curious.">
      <section class="open">
        <div>
          <p class="kicker">Architect, operator, governance practitioner</p>
          <p class="display">I don’t make AI sound magical. I make it operational.</p>
          <p class="dek">
            Architect by training. Global AI and Data Governance Lead at dsm-firmenich.
            Still curious about what systems mean for people.
          </p>
        </div>
        <figure class="specimen">
          <img src="/cabinet/annotated-brain-cutout.png" alt="A sculptural brain inscribed with data, curiosity, responsibility, reflection, AI and growth" />
          <figcaption>A mind is a kind of cabinet</figcaption>
        </figure>
      </section>

      <section class="block">
        <p class="kicker">01 · The throughline</p>
        <h2>More than twenty years. One recurring question.</h2>
        <p class="lead">How do we make complex systems work for people, and keep responsibility <em>human?</em></p>
        <p>
          For more than twenty years I have worked across solution architecture, global customer experience,
          technology operations, data quality, and governance. Different roles. One pattern: connect the
          technical system to the people who depend on it.
        </p>
        <p>
          The work has taken me from Barcelona to Tokyo, from Lima to New York. Across markets and
          disciplines I keep returning to the same things: clear meaning, accountable systems, and trust
          earned in practice.
        </p>
      </section>

      <section class="block">
        <p class="kicker">Barcelona · Tokyo · Lima · New York</p>
        <h2>Networks. Architecture. AI. Governance.</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="block">
        <p class="kicker">02 · Things I keep returning to</p>
        <h2>Some beliefs are less like answers than useful instruments.</h2>
        <ol class="beliefs">
          {beliefs.map((b) => (
            <li>
              <span>{b.n} · {b.k}</span>
              <p>{b.t}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="block split">
        <div>
          <p class="kicker">03 · Outside the title</p>
          <h2>People are the point. Curiosity is the method.</h2>
          <p>
            I have spent years close to the operational reality of technology: the customer waiting for a
            fix, the team interpreting a policy, the person expected to trust an AI system. That is why the
            work has to make sense to people, not only on paper.
          </p>
          <p>
            I contribute to DAMA España’s AI and Data Governance Working Group, write about the questions
            I meet in practice, and keep learning by building. Most recently, exploring agentic AI from the inside.
          </p>
          <p class="pull">“Data is our greatest asset.” It’s a good line. It’s also wrong. What’s actually greatest: people.</p>
        </div>
        <figure class="live">
          <video autoplay muted loop playsinline poster="/cabinet/data-jellyfish-cutout.png">
            <source src="/cabinet/live-specimen.webm" type="video/webm" />
          </video>
          <figcaption>Pelagic specimen · data in motion</figcaption>
        </figure>
      </section>

      <section class="close">
        <p class="kicker">A little more context</p>
        <h2>From architecture to AI governance. Still asking what it means for people.</h2>
        <p class="links">
          <a href="/context">Context</a>
          <a href="/writing">Writing</a>
        </p>
      </section>
    </RoomShell>
  </body>
</html>

<style>
  html { overflow-y: auto; overflow-x: clip; }
  body { overflow-y: auto; overflow-x: clip; min-height: 100svh; color: var(--bone); }

  .kicker {
    margin: 0;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  .open {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(12rem, 16rem);
    gap: 2.5rem;
    align-items: center;
  }

  .display {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 3.4vw, 3.15rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--bone);
  }

  .dek, .block p, .close p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.45;
    color: var(--flesh);
  }

  .dek { margin: 1.1rem 0 0; max-width: 34rem; }

  .specimen, .live {
    margin: 0;
  }

  .specimen img, .live video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 28rem;
    object-fit: contain;
    background: transparent;
  }

  figcaption {
    margin-top: 0.7rem;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  .block { margin-top: 5.5rem; }

  h2 {
    margin: 0.7rem 0 0;
    max-width: 18em;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 1.3rem 0 0;
    max-width: 36rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.3;
    color: var(--bone);
  }

  .lead em { color: var(--bronze); }

  .block p { max-width: 38rem; }

  .steps, .beliefs {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
  }

  .steps li, .beliefs li {
    padding: 1.15rem 0;
    border-top: 1px solid rgba(243, 235, 224, 0.14);
  }

  .steps h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: 1.45rem;
  }

  .steps p, .beliefs p { margin: 0.4rem 0 0; }

  .beliefs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .beliefs li { border-top: 1px solid rgba(170, 104, 66, 0.45); }

  .beliefs span {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  .beliefs p {
    font-size: 1.2rem;
    color: var(--bone);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(10rem, 16rem);
    gap: 2.5rem;
    align-items: center;
  }

  .pull {
    color: var(--gold) !important;
    font-size: 1.25rem !important;
  }

  .close { margin-top: 5.5rem; padding-top: 2rem; border-top: 1px solid rgba(170, 104, 66, 0.45); }

  .links { display: flex; gap: 1.6rem; margin-top: 1.4rem; font-style: normal; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .links a { color: var(--champagne); text-decoration: none; }
  .links a:hover { color: var(--gold); }

  @media (max-width: 800px) {
    .open, .split, .beliefs { grid-template-columns: 1fr; }
    .specimen {
      max-width: 16rem;
      justify-self: center;
      margin-inline: auto;
    }
    .specimen img {
      animation: cabinet-float 9s ease-in-out infinite;
    }
  }

  @keyframes cabinet-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .specimen img { animation: none; }
  }
</style>
