---
// Plain reverse-chronological archive, per docs/BUILD-ORDER.md step 3 & 7:
// "Writing first, since it has content." No invented copy -- every
// title, date, kind and thread below comes straight from the real
// content collection (src/content/config.ts, reading content/ itself),
// the same source /writing/[slug] renders from -- one source of truth,
// not the earlier hand-parsed content/_index.json snapshot.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { toArticleRow } from '../data/articleIndex';
import ThreadNerve from '../components/ThreadNerve.astro';
import ArticleList from '../components/ArticleList.astro';
import Nameplate from '../components/Nameplate.astro';

const entries = await getCollection('articles');
const bySource = entries.map(toArticleRow).sort((a, b) => (a.date < b.date ? 1 : -1));

// The mockup's "Current note / 01" frame, per the brief: its sample
// title and date were explicit placeholders ("replace with published
// work"), so the featured slot pulls the real most recent entry from
// the same sorted list the archive below renders, not invented copy.
// dek first (the article's own stated summary), the curated pull-quote
// second, same fallback order /writing/[slug].astro's own plate uses.
const featured = bySource[0];
const featuredBody = featured?.dek ?? featured?.lead ?? null;

// The section's own masthead -- a correction on the earlier awake-
// plate build, which bound this image to one specific article's front
// matter. Direct correction: "the tomato belongs here... not to any
// one article." This is the whole cabinet of writing's own cover, not
// a per-article treatment, so it isn't sourced from the content
// collection at all -- just this one local constant. null renders
// today exactly as it did before this existed (title, filter row,
// list, nothing missing or broken-looking); set it to bring the
// masthead up, no other code change needed. One subject (not a Dada
// collage of several) is the considered choice for now, consistent
// with the single-collision method the field's own specimens already
// use elsewhere on this site -- a multi-element collage would be a
// real, different choice, not a default to drift into.
const masthead: { image: string; alt: string } | null = {
  image: '/writing/tomato.png',
  alt: '',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Writing · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- The destination the departing nerve arrives at: Field.astro's
         click handler straightens and lifts the nerve toward the
         wordmark's own docked corner over the same window it already
         eases the horizontal pan in, then navigates -- a hard document
         cut, since this project uses no cross-document view
         transitions. This static line is the illusion half of that:
         present in the same corner from the instant this page loads,
         so nothing the eye was tracking changes shape across the cut,
         even though it's a different element on a different document.
         Gold here is the nerve itself, relocated and simplified, not a
         fourth gold thing invented for this page (CLAUDE.md
         non-negotiable 6). Breathes on its own via CSS -- no canvas,
         no JS timing loop, just a slow opacity/glow oscillation, so
         the "still pulsating" feeling the request asked for carries
         into a page that has no per-frame loop of its own. -->
    <div class="nerve-rest" aria-hidden="true"></div>
    <Nameplate />
    <main>
      <p class="back"><a href="/">Back to the field</a></p>

      <header class="hero">
        <h1>Ideas in<br /><em>circulation.</em></h1>
        <p class="deck">Writing from the space between systems and people.</p>
        <aside class="hero-side">
          I collect ideas, experiences, and connections. These are a few of the questions that
          stayed with me long enough to <strong>put into words.</strong>
          <p class="edition">Notes on meaning, trust &amp; responsibility</p>
        </aside>
      </header>

      {featured && (
        <section class="feature" aria-label="Most recent piece">
          <div class="feature-mark">
            <span class="serial">{featured.no ? `No.${String(featured.no).padStart(2, '0')}` : 'Latest'}</span>
          </div>
          <div class="feature-copy">
            <p class="tag">
              Most recent &nbsp;/&nbsp; {featured.threads[0] ?? featured.kind}
            </p>
            <h2><a href={`/writing/${featured.id}`}>{featured.title}</a></h2>
            {featuredBody && <p>{featuredBody}</p>}
            <div class="feature-bottom">
              <span class="meta">{featured.date.getFullYear()} &middot; {featured.kind}</span>
              <a href={`/writing/${featured.id}`}>Read the piece &nbsp;&#8600;</a>
            </div>
          </div>
        </section>
      )}

      {masthead && (
        <div class="masthead">
          <img src={masthead.image} alt={masthead.alt} />
        </div>
      )}

      <div class="tools">
        <ThreadNerve />
        <label class="search">
          <span aria-hidden="true">&#8981;</span>
          <input
            id="archive-search"
            type="search"
            placeholder="Search the archive"
            aria-label="Search the archive"
          />
        </label>
      </div>

      <ArticleList entries={bySource} />
      <p class="nothing" id="nothing" hidden>No pieces match that search.</p>
    </main>

    <script>
      // Pure client-side enhancement, per CLAUDE.md non-negotiable 7:
      // every row above is already real, server-rendered HTML -- with
      // no script at all, the full archive just shows, same as before
      // this existed. This only hides rows that don't match, it never
      // filters by thread (ThreadNerve's real links already do that
      // with JS off, via /thread/[name] -- this only adds text search
      // on top, scoped to whichever page you're already on).
      const input = document.getElementById('archive-search');
      const rows = Array.from(document.querySelectorAll('.list li'));
      const empty = document.getElementById('nothing');
      if (input && rows.length) {
        input.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          let visible = 0;
          for (const row of rows) {
            const match = !q || row.textContent!.toLowerCase().includes(q);
            row.hidden = !match;
            if (match) visible++;
          }
          if (empty) empty.hidden = visible !== 0;
        });
      }
    </script>
  </body>
</html>

<style>
  /* global.css sets html AND body to overflow:hidden, correct for the
     field (a fixed-viewport canvas that scrolls its own world) but
     wrong here -- this page overrode body's own overflow already, but
     never html's, and html is what actually governs whether the real
     viewport can scroll at all. Confirmed directly, not assumed: body's
     scrollHeight grew to include every row (real content, all present
     in the DOM), but window.scrollY stayed pinned at 0 through 20 real
     wheel/touch scroll attempts on a phone emulation -- the whole
     archive existed on the page and was completely unreachable below
     the first screen. html needs the same override body already has,
     not just body alone. */
  html {
    overflow-y: auto;
    overflow-x: hidden;
  }

  body {
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 100svh;
  }

  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    font-family: var(--font-mono);
    color: var(--bone);
  }

  /* Bone at rest, not gold -- gold is for the nerve, its beads, and
     whatever is awake (CLAUDE.md non-negotiable 6), not a resting
     link color. Hover/focus is the awake moment instead. */
  .back a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--bone);
    text-decoration: none;
  }

  .back a:hover,
  .back a:focus-visible {
    color: var(--gold);
  }

  .back a:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .hero {
    margin: 3rem 0 0;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 9vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 em {
    font-style: italic;
    color: var(--bronze);
  }

  .deck {
    margin: 1.1rem 0 0;
    max-width: 26rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.5;
    color: rgba(243, 235, 224, 0.78);
  }

  .hero-side {
    margin: 1.75rem 0 0;
    padding: 0 0 0 1rem;
    border-left: 1px solid rgba(243, 235, 224, 0.18);
    max-width: 26rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(243, 235, 224, 0.65);
  }

  .hero-side strong {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    color: var(--bone);
  }

  .edition {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  /* The mockup's "01" frame -- a single featured plate for the real
     most-recent piece (see the frontmatter comment on `featured`), not
     the mockup's own invented sample headline. Compact and orange-on-
     void, per the brief's "keep the orange frame and 01 motif
     compact," not a second hero. */
  .feature {
    margin: 2.5rem 0 0;
    border: 1px solid rgba(243, 235, 224, 0.18);
    display: grid;
    background: linear-gradient(135deg, #14110d, #0d0c0a 60%);
  }

  .feature-mark {
    display: flex;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(243, 235, 224, 0.14);
  }

  .feature-mark .serial {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2rem;
    color: var(--bronze);
    opacity: 0.85;
  }

  .feature-copy {
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .feature-copy .tag {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .feature-copy h2 {
    margin: 0.75rem 0 0.6rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .feature-copy h2 a {
    color: var(--bone);
    text-decoration: none;
  }

  .feature-copy h2 a:hover,
  .feature-copy h2 a:focus-visible {
    color: var(--gold);
  }

  .feature-copy p {
    margin: 0;
    font-family: var(--font-reading);
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(243, 235, 224, 0.7);
  }

  .feature-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(243, 235, 224, 0.12);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .feature-bottom .meta {
    color: rgba(243, 235, 224, 0.45);
  }

  .feature-bottom a {
    color: var(--bronze);
    text-decoration: none;
  }

  .feature-bottom a:hover,
  .feature-bottom a:focus-visible {
    color: var(--gold);
  }

  @media (min-width: 36rem) {
    .feature {
      grid-template-columns: 9rem 1fr;
    }

    .feature-mark {
      border-bottom: 0;
      border-right: 1px solid rgba(243, 235, 224, 0.14);
      justify-content: center;
    }
  }

  .tools {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.4em;
    border-bottom: 1px solid rgba(243, 235, 224, 0.2);
    min-width: 11rem;
  }

  .search span {
    color: var(--bronze);
  }

  .search input {
    background: none;
    border: 0;
    outline: 0;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--bone);
  }

  .search input::placeholder {
    color: rgba(243, 235, 224, 0.35);
  }

  .nothing {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: rgba(243, 235, 224, 0.5);
  }

  /* The nerve's own resting line, arrived at -- see the markup
     comment above for why this exists as static CSS rather than a
     shared, animated element. Full width (the departing nerve itself
     stays edge to edge even once flattened, only its vertical channel
     collapses -- see Field.astro's straightenAmt), faded at both ends
     rather than hard-cut, so it reads as a line running past the
     frame, not a bar sized to it. top/height approximate where
     Field.astro's own departure actually measures body.is-docked
     .mark h1's real rect and eases toward -- necessarily
     approximate, since this is a static illusion on a different
     document, not the same element, but close enough that nothing
     visibly jumps across the cut. */
  .nerve-rest {
    position: fixed;
    top: calc(38px + env(safe-area-inset-top));
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(247, 197, 106, 0.55) 12%,
      rgba(247, 197, 106, 0.55) 88%,
      transparent
    );
    filter: drop-shadow(0 0 5px rgba(247, 197, 106, 0.4));
    opacity: 0.75;
    pointer-events: none;
    z-index: 5;
    animation: nerve-rest-breathe 6.5s ease-in-out infinite;
  }

  /* breath, on Field.astro's own canvas, is a continuous sine read
     fresh every frame -- there's no equivalent loop here, so a plain
     CSS keyframe animation is the cheapest way to keep the same slow
     swell-and-ease feeling without inventing a JS timer for one static
     line. */
  @keyframes nerve-rest-breathe {
    0%, 100% {
      opacity: 0.55;
      filter: drop-shadow(0 0 3px rgba(247, 197, 106, 0.3));
    }
    50% {
      opacity: 0.9;
      filter: drop-shadow(0 0 8px rgba(247, 197, 106, 0.55));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nerve-rest {
      animation: none;
      opacity: 0.75;
    }
  }

  /* The section's masthead -- substitution and scale-shift, per direct
     critique: one real image standing in for a cover, held generously,
     bigger than any single article's own plate is ever allowed to be.
     void background (--void, true black, not a near-black -- same
     ground the field's own specimens composite against, see
     DESIGN-SYSTEM.md) so the image sits on the same ground a specimen
     does elsewhere on this site, not a website hero banner. Full
     image, not cropped -- object-fit: contain, letterboxed on void
     rather than object-fit: cover cutting into it, since this is the
     one place on the site allowed to show the whole thing. */
  .masthead {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0 0;
    padding: 1.5rem;
    background: var(--void);
    border: 1px solid rgba(243, 235, 224, 0.12);
  }

  .masthead img {
    display: block;
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
  }
</style>
