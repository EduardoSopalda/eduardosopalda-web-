---
// Writing room. The nerve is already the menu (RoomNerve). This page
// is the archive: one featured piece, then the rest by year, each
// carrying its own illustration when one exists. No sample titles.
// The tomato masthead was a stand-in; the plates are the articles'.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { toArticleRow } from '../data/articleIndex';
import { STOPS } from '../data/stops';
import ThreadNerve from '../components/ThreadNerve.astro';
import ArticleList from '../components/ArticleList.astro';
import RoomNerve from '../components/RoomNerve.astro';

const entries = await getCollection('articles');
const bySource = entries.map(toArticleRow).sort((a, b) => (a.date < b.date ? 1 : -1));
// The plate belongs to a piece that has one. A newer note with no
// illustration still leads the archive; it does not borrow a picture.
const featured = bySource.find((a) => a.image) ?? bySource[0];
const ahead = featured ? bySource.filter((a) => a.date > featured.date) : [];
const rest = featured ? bySource.filter((a) => a.id !== featured.id && !ahead.some((n) => n.id === a.id)) : bySource;
const context = STOPS.find((s) => s.href === '/context');

const months = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Writing · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <RoomNerve current="/writing" heading={false} />
    <main>
      <header class="page-head">
        <div>
          <h1>Writing</h1>
          <p class="standfirst">Twenty five signals, from the space between systems and people.</p>
        </div>
        <aside>
          <p class="aside-kicker">A field notebook</p>
          <p>The questions that stayed long enough to be written down.</p>
          <p class="aside-meta">Meaning · trust · responsibility</p>
        </aside>
      </header>
      {ahead.length > 0 && (
        <ol class="ahead">
          {ahead.map((a) => (
            <li>
              <a href={`/writing/${a.id}`}>
                <span>{a.date.getDate()} {months[a.date.getMonth()]} · {a.kind}</span>
                {a.title}
              </a>
            </li>
          ))}
        </ol>
      )}
      {featured && (
        <article class="featured">
          <div class="featured-copy">
            <p class="kicker">
              Current note
              {featured.no ? ` / ${String(featured.no).padStart(2, '0')}` : ''}
              · {featured.date.getDate()} {months[featured.date.getMonth()]} {featured.date.getFullYear()}
            </p>
            <h2><a href={`/writing/${featured.id}`}>{featured.title}</a></h2>
            {(featured.dek || featured.lead) && <p class="dek">{featured.dek || featured.lead}</p>}
            <a class="read" href={`/writing/${featured.id}`}>Read the note</a>
          </div>
          {featured.image && (
            <a class="featured-plate" href={`/writing/${featured.id}`} tabindex="-1" aria-hidden="true">
              <img src={featured.image} alt="" />
            </a>
          )}
        </article>
      )}

      <ThreadNerve />
      <ArticleList entries={rest} />

      {context && (
        <p class="next">
          <a href={context.href}>{context.label}</a>
          <span>{context.subtitle}</span>
        </p>
      )}
    </main>
  </body>
</html>

<style>
  html {
    overflow-y: auto;
    overflow-x: hidden;
  }

  body {
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 100svh;
  }

  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nerve-dock);
    background: var(--void);
    z-index: 15;
    pointer-events: none;
  }

  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: calc(var(--nerve-dock) + 2.75rem) 2.25rem 8rem;
    font-family: var(--font-mono);
    color: var(--bone);
  }

  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.42fr);
    gap: 4.5rem;
    align-items: end;
    margin: 0 0 5.5rem;
  }

  .eyebrow,
  .aside-kicker,
  .aside-meta {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .page-head h1 {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.6rem, 7.4vw, 6.2rem);
    line-height: 0.84;
    letter-spacing: -0.035em;
    color: var(--bone);
  }

  .standfirst {
    margin: 0.85rem 0 0;
    max-width: 14em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    color: var(--flesh);
  }

  aside {
    border-left: 1px solid var(--bronze);
    padding: 0.4rem 0 0.4rem 1.4rem;
    margin-bottom: 0.6rem;
  }

  aside p {
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--bone);
  }

  .aside-kicker,
  .aside-meta {
    font-family: var(--font-mono);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    column-gap: 3.5rem;
    row-gap: 1.4rem;
    align-items: stretch;
    margin-top: 1rem;
  }

  .featured-copy {
    grid-column: 1;
    grid-row: 1;
  }

  .featured-plate {
    grid-column: 2;
    grid-row: 1;
    display: block;
    margin-top: 0.4rem;
    min-height: 0;
    background: var(--void);
    border: 1px solid rgba(227, 175, 149, 0.35);
    overflow: hidden;
  }

  .featured-plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .featured-meta {
    grid-column: 1;
    grid-row: 2;
  }

  .ahead {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0 0 1.4rem;
    border-bottom: 1px solid rgba(243, 235, 224, 0.12);
  }

  .ahead a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .ahead span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .ahead a:hover {
    color: var(--gold);
  }

  .featured:not(:has(.featured-plate)) {
    grid-template-columns: 1fr;
    max-width: 40rem;
  }

  .kicker,
  .from,
  .threads {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .kicker {
    margin: 0;
  }

  .featured h2 {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .featured h2 a {
    color: inherit;
    text-decoration: none;
  }

  .featured h2 a:hover,
  .read:hover,
  .next a:hover {
    color: var(--gold);
  }

  .dek {
    margin: 1rem 0 0;
    max-width: 36rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--flesh);
  }

  .threads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    margin: 1.1rem 0 0;
    color: var(--bronze);
  }

  .read {
    display: inline-block;
    margin-top: 1.4rem;
    color: var(--bone);
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--bronze);
    padding-bottom: 0.2rem;
  }

  .from {
    margin: 4.5rem 0 0;
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 3.5rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(243, 235, 224, 0.12);
  }

  .next a {
    color: var(--bone);
    text-decoration: none;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .next span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--flesh);
  }

  @media (max-width: 800px) {
    .page-head,
    .featured {
      grid-template-columns: 1fr;
    }

    .featured-plate {
      order: -1;
      grid-column: 1;
      grid-row: 1;
      height: 16rem;
    }
  }
</style>
