---
// Writing room. The nerve is already the menu (RoomNerve). This page
// is the archive: one featured piece, then the rest by year, each
// carrying its own illustration when one exists. No sample titles.
// The tomato masthead was a stand-in; the plates are the articles'.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { toArticleRow } from '../data/articleIndex';
import { STOPS } from '../data/stops';
import ThreadNerve from '../components/ThreadNerve.astro';
import ArticleList from '../components/ArticleList.astro';
import RoomNerve from '../components/RoomNerve.astro';

const entries = await getCollection('articles');
const bySource = entries.map(toArticleRow).sort((a, b) => (a.date < b.date ? 1 : -1));
// The current note is the newest piece. It changes when a new one is
// published. The plate appears only if that piece has one.
const featured = bySource[0];
const rest = featured ? bySource.filter((a) => a.id !== featured.id) : bySource;
const context = STOPS.find((s) => s.href === '/context');

const months = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Writing · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <RoomNerve current="/writing" heading={false} />
    <main>
      <header class="room-title">
        <p class="room-kicker">Field notes</p>
        <h1>Writing <em>in circulation.</em></h1>
      </header>
      {featured && (
        <article class="featured">
          <div class="featured-copy">
            <p class="kicker">
              Current note
              {featured.no ? ` / ${String(featured.no).padStart(2, '0')}` : ''}
              · {featured.date.getDate()} {months[featured.date.getMonth()]} {featured.date.getFullYear()}
            </p>
            <h1><a href={`/writing/${featured.id}`}>{featured.title}</a></h1>
            {(featured.dek || featured.lead) && <p class="dek">{featured.dek || featured.lead}</p>}
            <a class="read" href={`/writing/${featured.id}`}>Read the note</a>
          </div>
          {featured.image && (
            <a class="featured-plate" href={`/writing/${featured.id}`} tabindex="-1" aria-hidden="true">
              <img src={featured.image} alt="" />
            </a>
          )}
        </article>
      )}

      <ThreadNerve />
      <ArticleList entries={rest} />

      {context && (
        <p class="next">
          <a href={context.href}>{context.label}</a>
          <span>{context.subtitle}</span>
        </p>
      )}
    </main>
  </body>
</html>

<style>
  html {
    overflow-y: auto;
    overflow-x: hidden;
  }

  body {
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 100svh;
  }

  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nerve-dock);
    background: var(--void);
    z-index: 15;
    pointer-events: none;
  }

  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: calc(var(--nerve-dock) + 2.75rem) 2.25rem 8rem;
    font-family: var(--font-mono);
    color: var(--bone);
  }

  .room-title {
    margin: 0 0 3.2rem;
  }

  .room-title h1 {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--bone);
  }

  .room-title em {
    display: block;
    font-style: italic;
    font-weight: 400;
    color: var(--bronze);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.72fr);
    gap: 4.5rem;
    align-items: stretch;
    margin: 0 0 1.4rem;
  }

  .featured-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .featured h1 {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.2rem, 6.2vw, 5.2rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--bone);
  }

  .featured h1 a {
    color: inherit;
    text-decoration: none;
  }

  .featured h1 a:hover,
  .read:hover {
    color: var(--gold);
  }

  .featured-plate {
    display: block;
    min-height: 18rem;
    background: var(--void);
    border: 1px solid rgba(170, 104, 66, 0.55);
    overflow: hidden;
  }

  .featured-plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .featured-meta {
    grid-column: 1;
    grid-row: 2;
  }

  .ahead {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0 0 1.4rem;
    border-bottom: 1px solid rgba(243, 235, 224, 0.12);
  }

  .ahead a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .ahead span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .ahead a:hover {
    color: var(--gold);
  }

  .featured:not(:has(.featured-plate)) {
    grid-template-columns: 1fr;
    max-width: 40rem;
  }

  .kicker,
  .from,
  .threads {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  .kicker {
    margin: 0;
    color: var(--bronze);
  }

  .dek {
    margin: 1.2rem 0 0;
    max-width: 34rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--flesh);
  }

  .read {
    display: inline-block;
    align-self: flex-start;
    margin-top: 1.8rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--bronze);
    color: var(--champagne);
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .from {
    margin: 4.5rem 0 0;
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 3.5rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(243, 235, 224, 0.12);
  }

  .next a {
    color: var(--bone);
    text-decoration: none;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .next span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--flesh);
  }

  @media (max-width: 800px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured-plate {
      order: -1;
      grid-column: 1;
      grid-row: 1;
      height: 16rem;
    }
  }
</style>
