---
import '../styles/fraunces.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import RoomNerve from '../components/RoomNerve.astro';

const talks = [
  {
    href: '/out-loud/automa-chem-2026',
    title: 'Data and AI in Sustainable Digital Transformation',
    deck: 'From Brasília to the Plant Floor',
    meta: 'Opens after 26 October · Estrel Berlin',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Out Loud · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <RoomNerve current="/out-loud" />
    <main>
      <ol class="list">
        {
          talks.map((talk) => (
            <li>
              <a class="row" href={talk.href}>
                <span class="title">{talk.title}</span>
                <span class="deck">{talk.deck}</span>
                <span class="meta">{talk.meta}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="todo">TODO (Eduardo): the other transcriptions. He is transcribing them (see CLAUDE.md).</p>
    </main>
  </body>
</html>

<style>
  html {
    overflow-y: auto;
    overflow-x: hidden;
  }

  body {
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 100svh;
  }

  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: calc(var(--nerve-dock) + 3.5rem) 1.5rem 6rem;
    font-family: var(--font-mono);
    color: var(--bone);
  }

  .back a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--bone);
    text-decoration: none;
  }

  .back a:hover,
  .back a:focus-visible,
  .row:hover .title,
  .row:focus-visible .title {
    color: var(--gold);
  }

  .back a:focus-visible,
  .row:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .label {
    margin: 2.5rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(227, 175, 149, 0.55);
  }

  h1 {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.8rem;
  }

  .cover {
    display: block;
    margin-top: 1.75rem;
    background: #000;
  }

  .cover img {
    width: 100%;
    height: auto;
  }

  .list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .list li {
    border-top: 1px solid rgba(243, 235, 224, 0.12);
  }

  .row {
    display: block;
    padding: 1.15rem 0;
    text-decoration: none;
    color: inherit;
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .deck {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--oxide-lit);
  }

  .meta {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(243, 235, 224, 0.4);
  }

  .todo {
    margin: 2rem 0 0;
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(243, 235, 224, 0.4);
  }
</style>
