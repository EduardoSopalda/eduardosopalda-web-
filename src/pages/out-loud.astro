---
import '../styles/fraunces.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import RoomNerve from '../components/RoomNerve.astro';
import RoomShell from '../components/RoomShell.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Out Loud · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <RoomNerve current="/out-loud" heading={false} />
    <RoomShell title="Out loud" italic="in the room.">
      <p class="kicker">AUTOMA Chem 2026 · Estrel Berlin · 26 October · 9:40</p>
      <h2>Data and AI in Sustainable Digital Transformation</h2>
      <p class="deck">From Brasília to the plant floor.</p>
      <p>
        A plan can be right from above and still fail the person who has to walk it.
        That distance is the talk.
      </p>
      <p class="closed">The film and the script stay closed until after it is given.</p>
      <p class="links"><a href="/out-loud/automa-chem-2026">The Berlin note</a></p>
    </RoomShell>
  </body>
</html>

<style>
  html { overflow-y: auto; overflow-x: clip; }
  body { overflow-y: auto; overflow-x: clip; min-height: 100svh; color: var(--bone); }

  .kicker {
    margin: 0;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  h2 {
    margin: 0.8rem 0 0;
    max-width: 16em;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .deck, p {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--flesh);
  }

  .deck {
    margin: 0.7rem 0 0;
    font-size: 1.25rem;
  }

  p {
    max-width: 34rem;
    margin: 1.4rem 0 0;
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .closed {
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  .links { margin-top: 1.8rem; font-style: normal; }
  .links a {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bronze);
    text-decoration: none;
    border-bottom: 1px solid rgba(170, 104, 66, 0.7);
  }
  .links a:hover { color: var(--gold); }
</style>
