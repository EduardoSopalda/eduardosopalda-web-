---
// Out Loud · Berlin. AUTOMA Chem 2026, Estrel Berlin, 26 October 2026.
//
// Two builds, decided at BUILD time (the site is static, on IONOS):
//
// - CLOSED (any build before 26 Oct 2026, 10:00 CET = 09:00 UTC):
//   only the sealed hero and the countdown. No film URL, no thumbnails,
//   no section titles, no narration, no Kith note, and noindex. When
//   the countdown reaches zero, the page reloads (at most every two
//   minutes) so it picks up the open build once it is deployed.
// - OPEN (BERLIN_OPEN=1, or a build at/after BERLIN_OPENS): the page
//   Eduardo approved as the colleague preview at
//   eduardosopalda.com/automa-2026-film/ -- hero, contents, the narrated
//   film with its chapter strip, each section with what is said in it,
//   the question left in the room, the colophon, and the Kith AI Lab
//   note at the very bottom. The preview's feedback section and its
//   "private preview" labels are deliberately not carried over.
//
// The scheduled IONOS deploy on the 26th (.github/workflows/deploy-ionos.yml)
// is what turns the closed build into the open one.
import '../../styles/fraunces.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource-variable/newsreader/opsz.css';
import '../../styles/global.css';
import RoomNerve from '../../components/RoomNerve.astro';
import { BERLIN_OPENS, berlinOpen } from '../../data/berlin';
import { FILM_SRC, FILM_POSTER, FILM_LENGTH, SECTIONS } from '../../data/berlin-film';

const open = process.env.BERLIN_OPEN === '1' || berlinOpen();

const canonicalUrl = new URL('/out-loud/automa-chem-2026/', Astro.site);
const ogImageUrl = new URL('/out-loud/automa-chem-2026/film-poster.jpg', Astro.site);
const description = 'Data and AI in Sustainable Digital Transformation. From Brasília to the Plant Floor. AUTOMA Chem 2026, Estrel Berlin, 26 October 2026.';

// Derived from FILM_LENGTH rather than a second hardcoded copy -- a
// stray "7 minutes 47" aria-label is what drifted out of sync when the
// film itself was replaced and FILM_LENGTH alone got updated.
const [filmMin, filmSec] = FILM_LENGTH.split(':').map(Number);
const filmSpoken = `${filmMin} minute${filmMin === 1 ? '' : 's'}${filmSec ? ` ${filmSec}` : ''}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Berlin · Out Loud · EDUARDO sopalda</title>
    <meta name="description" content={description} />
    {!open && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Out loud · Berlin" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
  </head>
  <body data-state={open ? 'open' : 'sealed'}>
    <RoomNerve current="/out-loud" heading={false} />

    <main class="berlin" id="main">
      <header class="hero">
        <p class="label">Out loud · Berlin</p>
        <h1>Data and AI in <span>Sustainable Digital Transformation</span></h1>
        <p class="subtitle">From Brasília to the Plant Floor</p>
        <p class="speaker">Eduardo Sopalda · D&amp;T Global Data Governance Lead · <span class="brand-name">dsm-firmenich</span> · AUTOMA Chem 2026, Estrel Berlin, 26 October</p>
      </header>

      {!open && (
        <section class="seal" aria-labelledby="seal-k">
          <p class="label" id="seal-k">Sealed</p>
          <p class="seal-l">The film and what is said in it open <em>after the talk is given.</em></p>
          <p class="count" id="count" aria-live="polite">26 October · 10:00 CET</p>
        </section>
      )}

      {open && (
        <>
          <section class="feedback" aria-labelledby="fb-k">
            <p class="label" id="fb-k">What people are saying</p>
            <p class="fb-q">"&hellip;it was so engaging that I listened to every word and loved the animation. Fantastic!!"</p>
            <p class="fb-by">Yvonne Espinosa · Co-Founder, Kith AI Lab &amp; Kith Climate</p>
            <p class="fb-note">This film will also be shared with the cohorts of <a href="https://kithailab.com/" target="_blank" rel="noopener">Kith AI Lab</a>.</p>
          </section>

          <nav class="toc" aria-label="On this page">
            <a href="#film"><b>01</b>The film</a>
            <a href="#sections"><b>02</b>Sections and script</a>
          </nav>

          <section id="film" aria-labelledby="film-title">
            <p class="label">01 · The film</p>
            <h2 id="film-title">The talk, narrated</h2>
            <div class="film">
              <video
                id="v"
                src={FILM_SRC}
                poster={FILM_POSTER}
                controls
                preload="metadata"
                playsinline
                aria-label={`The talk as a narrated film, ${filmSpoken}`}
              ></video>
              <div class="film-meta"><span>Voice, music, animation</span><span>{FILM_LENGTH}</span></div>
            </div>
            <ol class="chapters" aria-label="Chapters">
              {SECTIONS.map((s) => (
                <li>
                  <button type="button" class="chap" data-t={s.at}>
                    <img src={s.thumb} alt="" loading="lazy" width="320" height="180" />
                    <span class="ct">{s.time}</span>
                    <span class="cn">{s.label}</span>
                    <span class="cx">{s.title}</span>
                  </button>
                </li>
              ))}
            </ol>
          </section>

          <section id="sections" aria-labelledby="sec-title">
            <p class="label">02 · Sections and script</p>
            <h2 id="sec-title">Each section, and what is said in it</h2>
            <div class="acts">
              {SECTIONS.map((s, i) => (
                <article class="act" id={`act-${i}`}>
                  <div class="act-head">
                    <button type="button" class="chap thumb" data-t={s.at} aria-label={`Play ${s.label} from ${s.time}`}>
                      <img src={s.thumb} alt="" loading="lazy" width="320" height="180" />
                      <span class="play">Play from {s.time}</span>
                    </button>
                    <p class="label act-label">{s.label} · {s.time}</p>
                    <h3>{s.title}</h3>
                  </div>
                  <div class="act-text">
                    {s.paras.map((p) => <p class={s.quiet ? 'quiet' : undefined}>{p}</p>)}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="question" aria-labelledby="q-k">
            <p class="label" id="q-k">The question I left in the room</p>
            <p class="q">What is one word in your organisation that means something different depending on which floor you are standing on?</p>
            <p class="after">I asked it in Berlin. Now I am asking you.</p>
            <p class="links"><a href="/contact">Send me your word</a></p>
          </section>

          <dl class="colophon">
            <div><dt>Event</dt><dd>AUTOMA Chem 2026</dd></div>
            <div><dt>Room</dt><dd>Estrel Berlin<br />26 October 2026 · 10:00</dd></div>
            <div><dt>Speaker</dt><dd>Eduardo Sopalda<br />D&amp;T Global Data Governance Lead, <span class="brand-name" style="white-space:nowrap">dsm-firmenich</span></dd></div>
            <div><dt>Film</dt><dd>{FILM_LENGTH} · six acts<br />voice, music, animation</dd></div>
          </dl>

          <aside class="shared" aria-label="Shared with">
            <span class="shared-rule" aria-hidden="true"></span>
            <p class="shared-k">Shared with the cohorts of</p>
            <p class="shared-n"><a href="https://kithailab.com/" target="_blank" rel="noopener">Kith AI Lab</a></p>
          </aside>
        </>
      )}

      <p class="back"><a href="/out-loud">← Out loud</a></p>
    </main>

    {open ? (
      <script is:inline>
        /* Chapters: seek, play, and bring the film into view; the active
           chapter in the strip follows playback. */
        (() => {
          const v = document.getElementById('v');
          if (!v) return;
          const strip = [...document.querySelectorAll('.chapters .chap')];
          const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
          document.querySelectorAll('.chap').forEach((b) =>
            b.addEventListener('click', () => {
              v.currentTime = +b.dataset.t;
              v.play().catch(() => {});
              document.getElementById('film').scrollIntoView({ behavior: smooth, block: 'start' });
            })
          );
          const mark = () => {
            let k = 0;
            strip.forEach((b, i) => { if (v.currentTime >= +b.dataset.t) k = i; });
            strip.forEach((b, i) => {
              b.classList.toggle('on', i === k);
              if (i === k) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current');
            });
          };
          v.addEventListener('timeupdate', mark);
          v.addEventListener('seeked', mark);
        })();
      </script>
    ) : (
      <script is:inline define:vars={{ opens: BERLIN_OPENS }}>
        /* Countdown to 26 Oct 2026, 10:00 CET (BERLIN_OPENS in
           src/data/berlin.ts). At zero, reload so the open build shows
           once it is deployed -- at most every two minutes, so a late
           deploy never turns into a reload loop. */
        (() => {
          const count = document.getElementById('count');
          if (!count) return;
          const KEY = 'berlin-open-reload';
          const tick = () => {
            const ms = Math.max(0, opens - Date.now());
            if (ms === 0) {
              count.textContent = 'Opening now';
              const last = +(sessionStorage.getItem(KEY) || 0);
              if (Date.now() - last > 120e3) {
                sessionStorage.setItem(KEY, String(Date.now()));
                location.reload();
              }
              return;
            }
            const d = Math.floor(ms / 864e5), h = Math.floor(ms / 36e5) % 24, m = Math.floor(ms / 6e4) % 60;
            count.textContent = `Opens in ${d} d · ${String(h).padStart(2, '0')} h · ${String(m).padStart(2, '0')} m`;
          };
          tick();
          setInterval(tick, 30e3);
        })();
      </script>
    )}
  </body>
</html>

<style>
  /* global.css locks html/body for the field; this room page-scrolls. */
  html { overflow-y: auto; overflow-x: clip; scroll-behavior: smooth; }
  body { overflow-y: auto; overflow-x: clip; min-height: 100svh; color: var(--bone); }

  .berlin {
    --line: rgba(227, 175, 149, 0.22);
    --muted: #b9ad9f;
    --body: #d9ccbe;
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--nerve-dock) clamp(20px, 5vw, 64px) 96px;
    font: 18px/1.58 var(--font-reading);
    color: var(--bone);
  }

  .label {
    margin: 0;
    color: var(--flesh);
    font: 12px/1.6 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ── hero ── */
  .hero { padding: clamp(56px, 8vw, 110px) 0 0; }
  h1 {
    margin: 20px 0 12px;
    font: 400 clamp(46px, 7vw, 96px)/0.99 var(--font-display);
    letter-spacing: -0.045em;
    color: var(--bone);
  }
  h1 span { color: var(--flesh); font-style: italic; }
  .subtitle { margin: 14px 0 0; color: var(--flesh); font: italic 400 clamp(21px, 2.6vw, 30px)/1.25 var(--font-display); }
  .speaker { margin: 26px 0 0; font: 13px/1.7 var(--font-mono); color: var(--bone); }

  /* ── closed: seal + countdown ── */
  .seal { margin-top: 64px; padding: 34px 0 0; border-top: 1px solid var(--line); }
  .seal-l { margin: 14px 0 0; max-width: 18em; font: 400 clamp(26px, 3.4vw, 40px)/1.12 var(--font-display); letter-spacing: -0.02em; }
  .seal-l em { color: var(--flesh); }
  .count { margin: 22px 0 0; color: var(--gold); font: 13px var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; font-variant-numeric: tabular-nums; }

  /* ── contents ── */
  .toc { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 54px 0 0; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font: 13px var(--font-mono); letter-spacing: 0.06em; }
  .toc a { color: var(--body); text-decoration: none; border-bottom: 1px solid transparent; }
  .toc a:hover { color: var(--bone); border-color: var(--bronze); }
  .toc b { color: var(--muted); font-weight: 400; margin-right: 6px; }

  section { border-top: 1px solid var(--line); padding: 34px 0 0; margin-top: 76px; }
  h2 { margin: 8px 0 0; font: 400 clamp(30px, 4vw, 46px)/1.08 var(--font-display); letter-spacing: -0.02em; color: var(--bone); }

  /* ── film ── */
  .film { margin-top: 30px; }
  .film video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #0a0908; border: 1px solid var(--line); }
  .film-meta { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; color: var(--muted); font: 12px/1.5 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }

  .chapters { list-style: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12px; }
  .chap { display: block; width: 100%; padding: 0; border: 0; background: none; color: var(--bone); text-align: left; cursor: pointer; font: inherit; }
  .chap img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--line); opacity: 0.82; transition: opacity 0.2s, border-color 0.2s; }
  .chap:hover img, .chap.on img, .chap:focus-visible img { opacity: 1; border-color: var(--flesh); }
  .chap span { display: block; }
  .ct { margin-top: 8px; color: var(--muted); font: 12px var(--font-mono); }
  .cn { margin-top: 2px; color: var(--flesh); font: 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .cx { margin-top: 2px; font: 15px/1.3 var(--font-display); }

  a:focus-visible, button:focus-visible, video:focus-visible { outline: 2px solid var(--flesh); outline-offset: 5px; }

  /* ── sections ── */
  .acts { margin-top: 26px; }
  .act { display: grid; grid-template-columns: minmax(240px, 0.6fr) minmax(0, 1.4fr); gap: clamp(22px, 5vw, 70px); padding: 28px 0; border-top: 1px solid var(--line); align-items: start; }
  .thumb { position: relative; }
  .play { position: absolute; left: 10px; bottom: 10px; padding: 5px 9px; background: rgba(0, 0, 0, 0.72); color: var(--bone); font: 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .act-label { margin-top: 12px; }
  .act h3 { margin: 4px 0 0; font: 400 clamp(22px, 2.6vw, 30px)/1.12 var(--font-display); color: var(--bone); }
  .act-text p { margin: 0 0 12px; color: var(--body); font-size: 18px; }
  .act-text p.quiet { color: var(--muted); font-style: italic; }

  /* ── the question left in the room ── */
  .question { margin-top: 96px; }
  .question .q { font-family: var(--font-display); letter-spacing: -0.025em; color: var(--bone); font-size: clamp(1.9rem, 3.2vw, 2.9rem); line-height: 1.08; font-weight: 400; max-width: 17em; margin: 1rem 0 0; }
  .question .after { font-family: var(--font-display); font-style: italic; color: var(--flesh); font-size: 1.15rem; line-height: 1.45; max-width: 30rem; margin: 1.5rem 0 0; }
  .question .links { margin: 1.8rem 0 0; }
  .question .links a { font: 12px var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--bronze); border-bottom: 1px solid rgba(170, 104, 66, 0.7); text-decoration: none; }
  .question .links a:hover, .question .links a:focus-visible { color: var(--gold); }

  /* ── what people are saying (direct request, given more presence
     than a footer mention -- same scale of treatment as the question
     left in the room, not a small aside) ── */
  .feedback { margin-top: 96px; }
  .feedback .fb-q { font-family: var(--font-display); font-style: italic; letter-spacing: -0.01em; color: var(--bone); font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1.32; max-width: 34rem; margin: 1.2rem 0 0; }
  .feedback .fb-by { font: 13px/1.7 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--flesh); margin: 1.4rem 0 0; }
  .feedback .fb-note { font-family: var(--font-display); font-style: italic; color: var(--flesh); font-size: 1.05rem; line-height: 1.45; max-width: 30rem; margin: 1.5rem 0 0; }
  .feedback .fb-note a { color: var(--gold); text-decoration: none; border-bottom: 1px solid rgba(247, 197, 106, 0.35); }
  .feedback .fb-note a:hover, .feedback .fb-note a:focus-visible { color: var(--flesh); border-color: var(--flesh); }

  /* ── colophon ── */
  .colophon { margin: 88px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2rem; border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .colophon dt { font: 11px var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; color: rgba(230, 203, 155, 0.6); }
  .colophon dd { margin: 0.35rem 0 0; font-family: var(--font-display); color: var(--bone); font-size: 0.98rem; line-height: 1.3; }

  /* ── closing note: Kith AI Lab ── */
  .shared { margin: 120px auto 0; padding: 0 0 8px; text-align: center; }
  .shared-rule { display: block; width: 72px; height: 1px; margin: 0 auto 28px; background: linear-gradient(90deg, rgba(247, 197, 106, 0), var(--gold) 50%, rgba(247, 197, 106, 0)); }
  .shared-k { margin: 0; font: 11px/1.6 var(--font-mono); letter-spacing: 0.24em; text-transform: uppercase; color: var(--champagne); }
  .shared-n { margin: 10px 0 0; font: italic 400 clamp(26px, 3vw, 34px)/1.15 var(--font-display); letter-spacing: -0.01em; }
  .shared-n a { color: var(--gold); text-decoration: none; border-bottom: 1px solid rgba(247, 197, 106, 0.35); padding-bottom: 2px; transition: color 0.3s, border-color 0.3s; }
  .shared-n a:hover, .shared-n a:focus-visible { color: var(--flesh); border-color: var(--flesh); }

  .back { margin: 72px 0 0; font: 12px var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; }
  .back a { color: var(--champagne); text-decoration: none; }
  .back a:hover { color: var(--gold); }
  body[data-state='open'] .back { text-align: center; margin-top: 48px; }

  @media (max-width: 860px) {
    .chapters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .act { grid-template-columns: 1fr; gap: 14px; }
    .colophon { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.6rem; }
    .shared { margin-top: 88px; }
  }
  @media (max-width: 420px) {
    .film-meta { font-size: 11px; }
    .speaker { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .chap img, .shared-n a { transition: none; }
  }
</style>
