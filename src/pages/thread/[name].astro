---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { toArticleRow } from '../../data/articleIndex';
import { THREADS, threadForSlug } from '../../data/threads';
import ThreadNerve from '../../components/ThreadNerve.astro';
import ArticleList from '../../components/ArticleList.astro';
import RoomNerve from '../../components/RoomNerve.astro';

export async function getStaticPaths() {
  return THREADS.map((t) => ({ params: { name: t.toLowerCase() } }));
}

const thread = threadForSlug(Astro.params.name!)!;
const entries = await getCollection('articles');
const bySource = entries
  .map(toArticleRow)
  .filter((a) => a.threads.includes(thread))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{thread} · Writing · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <RoomNerve current="/writing" heading={false} />
    <main>
      <header class="room-title">
        <p class="room-kicker">Field notes</p>
        <h1>Writing<em>in circulation.</em></h1>
      </header>
      <div class="room">
        <p class="back"><a href="/writing">All writing</a></p>
        <ThreadNerve active={thread} />
        {bySource.length > 0 ? (
          <ArticleList entries={bySource} />
        ) : (
          <p class="none">Nothing under {thread} yet.</p>
        )}
      </div>
    </main>
  </body>
</html>

<style>
  html {
    overflow-y: auto;
    overflow-x: clip;
  }

  body {
    overflow-x: clip;
    min-height: 100svh;
  }

  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nerve-dock);
    background: var(--void);
    z-index: 15;
    pointer-events: none;
  }

  main {
    --rail: 17rem;
    --inset: 1.75rem;
    --gutter: 3rem;
    display: grid;
    grid-template-columns: var(--rail) var(--gutter) minmax(0, 1fr);
    align-items: start;
    margin: 0;
    max-width: none;
    padding: calc(var(--nerve-dock) + 2.75rem) 2.5rem 7.5rem var(--inset);
    font-family: var(--font-mono);
    color: var(--bone);
  }

  .room-title {
    grid-column: 1;
    position: fixed;
    top: calc(var(--nerve-dock) + 2.2rem);
    left: var(--inset);
    z-index: 12;
    width: var(--rail);
    margin: 0;
  }

  .room {
    grid-column: 3;
    min-width: 0;
  }

  .room-kicker {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--champagne);
  }

  .room-kicker::after {
    content: '';
    display: inline-block;
    width: 1.6rem;
    height: 1px;
    margin-left: 0.65rem;
    vertical-align: middle;
    background: rgba(170, 104, 66, 0.7);
  }

  .room-title h1 {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.1rem, 4.4vw, 4.4rem);
    line-height: 0.86;
    letter-spacing: -0.03em;
    color: var(--bone);
  }

  .room-title em {
    display: block;
    margin: 0.28em 0 0 2.4em;
    font-style: italic;
    font-weight: 400;
    font-size: 0.38em;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--bronze);
  }

  .back {
    margin: 0 0 1.4rem;
  }

  .back a {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--champagne);
    text-decoration: none;
  }

  .back a:hover,
  .back a:focus-visible {
    color: var(--gold);
  }

  .none {
    margin: 2rem 0 0;
    font-size: 0.8rem;
    color: rgba(243, 235, 224, 0.4);
  }

  @media (max-width: 900px) {
    main {
      display: block;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .room-title {
      position: static;
      width: auto;
      margin: 0 0 2.4rem;
    }

    .room {
      display: block;
    }
  }
</style>
