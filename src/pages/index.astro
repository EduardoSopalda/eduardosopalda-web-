---
// Newsreader was loaded here but never referenced by any component on
// this page -- --font-reading in tokens.css exists for the future
// Reader component (see CLAUDE.md's repo layout), which doesn't exist
// yet. Pure dead weight on the one page that does exist today; the
// Reader can import it itself once it's built.
import '../styles/fraunces.css';
import '@fontsource/italiana';
import 'typeface-glacial-indifference';
import '@fontsource/ibm-plex-mono/400.css';
// 600 (SemiBold) is the seven stops' own weight only -- see .stop's
// own comment in Field.astro. Everything else using --font-mono
// (citations, specimen tags, footer meta) stays at 400.
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Field from '../components/Field.astro';
import Landing from '../components/Landing.astro';

// Reused verbatim from Landing.astro's own .purpose line -- Eduardo's
// approved copy, not a new sentence -- for the two places a stranger
// actually reads text before the page itself: the meta description
// and the social preview card.
const description = 'Understand it first… then you decide if you trust it.';

// og:url/og:image previously hardcoded "eduardosopalda.com" (no www),
// while astro.config.mjs's own `site` is "www.eduardosopalda.com" --
// two different canonical hosts for the same page, so every share
// preview and any crawler honoring canonical URLs saw a mismatch.
// Both now derive from Astro.site, the one place the real host is
// meant to be decided, so they can't drift apart from it again.
const canonicalUrl = new URL('/', Astro.site);
const ogImageUrl = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="EDUARDO sopalda" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="EDUARDO sopalda" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#000000" />
  </head>
  <body data-landing="landing">
    {/* Runs before Field/Landing paint a single frame -- same is:inline,
        before-paint pattern Landing.astro's own wordmark script uses.
        "The transition to go back to the main page is the same as the
        landing page" -- direct feedback: this document is reached by a
        real navigation (not a client route) from every room, so without
        this, EVERY return trip replayed the full Act I hero and the
        nerve's own flat-to-curved entrance from zero, even for a
        visitor who was already standing in the live, drifting field
        thirty seconds earlier. sessionStorage (set by Landing.astro's
        dock(), cleared by its undock()) is the only thing that persists
        across that hard navigation. Setting both here, synchronously,
        is what Landing.astro's dock() itself does at the DOM level --
        this just does it before first paint instead of animating into
        it, for a tab that's already seen the real thing once. */}
    <script is:inline>
      // A room clears this flag. Coming home replays the landing drop,
      // the nerve stopping above the message, instead of arriving
      // already in the field.
      if (sessionStorage.getItem('sopalda-docked') === '1') {
        document.body.setAttribute('data-landing', 'field');
        document.body.classList.add('is-docked');
      }
      if (sessionStorage.getItem('sopalda-return') === '1') {
        document.body.classList.add('is-returning');
        sessionStorage.removeItem('sopalda-return');
        const nerve = document.getElementById('nerve');
        const rail = document.getElementById('nerve-rail');
        if (nerve) nerve.style.opacity = '0';
        if (rail) rail.style.opacity = '1';
      }
    </script>
    <Field />
    <Landing />
  </body>
</html>
