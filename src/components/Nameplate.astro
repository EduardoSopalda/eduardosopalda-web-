---
// Direct feedback: the name disappears the instant a visitor leaves
// the field. Landing.astro's own docked wordmark (body.is-docked
// .mark -- EDUARDO / sopalda / the tagline, fixed top-right) only
// exists on "/" itself; every room page past it had nothing there at
// all, just writing.astro's own .nerve-rest illusion of a line arriving
// at a corner that, on that page, held no actual name. This is that
// same corner lockup, ported as a plain static element (no
// splitWord()/animateWordmark() -- there's no hero entrance to animate
// on a room page, the name is just always already there), so the
// identity the field's departure visually hands off to is actually
// waiting on the other side of the cut, on every page, not only the
// one the nerve happens to have been drawn on.
//
// Same self-hosted font imports Landing.astro's own mark uses --
// Italiana for EDUARDO, Glacial Indifference for sopalda -- so this
// renders in the real wordmark faces wherever it appears, not a system
// serif/sans-serif fallback on pages that never had a reason to load
// them before.
import '@fontsource/italiana';
import 'typeface-glacial-indifference';

// Audit finding: this used to be an <h2>, rendered before <main> on
// every page it appears on -- so the DOM heading order was h2 (this)
// then h1 (the page's own title), an inverted hierarchy. A repeated
// site-identity mark isn't page content structure (automa-chem-2026's
// own .door-mark already gets this right, as a plain link with no
// heading at all) -- a <p> keeps the exact same look with nothing in
// the heading outline to invert.
---

<a class="nameplate" href="/" aria-label="Eduardo Sopalda -- back to the field">
  <p class="name">
    <span class="given">EDUARDO</span>
    <span class="family">sopalda</span>
  </p>
  <p class="tagline">DATA | AI <span class="amp">&amp;</span> the human experience</p>
</a>

<style>
  /* Byte-for-byte the same corner Landing.astro's body.is-docked .mark
     occupies (top: 18px + safe-area-inset-top, right: 28px), so a
     visitor arriving from a departure never sees the name land
     somewhere slightly different depending on which document it's on. */
  .nameplate {
    position: fixed;
    top: calc(18px + env(safe-area-inset-top));
    right: 28px;
    z-index: 5;
    text-align: right;
    text-decoration: none;
    color: inherit;
  }

  .nameplate .name {
    margin: 0;
    line-height: 0.88;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .given {
    font-family: 'Italiana', serif;
    font-weight: 400;
    font-size: clamp(0.95rem, 3.1vw, 1.2rem);
    letter-spacing: 0.1em;
    color: var(--bronze);
  }

  .family {
    font-family: 'Glacial Indifference', sans-serif;
    font-weight: 700;
    font-size: clamp(1.28rem, 4.1vw, 1.65rem);
    letter-spacing: 0;
    color: var(--flesh);
  }

  .tagline {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.42rem, 1.7vw, 0.52rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--champagne);
    max-width: 16rem;
  }

  .tagline .amp {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2em;
    letter-spacing: 0;
    opacity: 0.85;
  }

  /* Bone at rest is this site's convention for every other resting
     link (see every room's own .back a) -- the nameplate is the one
     deliberate exception, same as it is on the field itself: it's
     always rendered in its own bronze/flesh, not dimmed to bone until
     hovered, because it's identity, not a navigation affordance
     dressed up as plain text. A quiet brightening on hover/focus is
     still real feedback that it's a live link back to the field. */
  .nameplate:hover .given,
  .nameplate:focus-visible .given {
    color: var(--gold);
  }

  .nameplate:hover .family,
  .nameplate:focus-visible .family {
    color: var(--gold);
  }

  .nameplate:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 6px;
    border-radius: 2px;
  }
</style>
