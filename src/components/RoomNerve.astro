---
// The arrived nerve. Same filament that left the field: edge to edge,
// just under the room plate (upper right), still carrying light.
// The seven stops stay on it. The room you are in is the awake bead.
// "Eduardo" at the left end is the way back to the field — not a
// second menu. Contact remains the last stop, where it already was.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/italiana';
import 'typeface-glacial-indifference';
import '@fontsource/italiana';
import 'typeface-glacial-indifference';
import { STOPS } from '../data/stops';

interface Props {
  current: string;
  // Empty rooms have no other title, so the plate is the h1. Archive
  // and reader pages already have their own heading; there the plate
  // is a landmark, not a second h1.
  heading?: boolean;
}

const { current, heading = true } = Astro.props;
const here = STOPS.find((s) => s.href === current);
---

<header class="room-nerve" data-arrive="0">
  <a class="mark" href="/" aria-label="Eduardo Sopalda, home">
    <span class="name">
      <span class="given">EDUARDO</span>
      <span class="family">sopalda</span>
    </span>
    <span class="tagline">DATA | AI <span class="amp">&</span> The human experience</span>
  </a>
  <button type="button" class="menu-toggle" aria-expanded="true" aria-controls="room-stops">Main</button>
  <nav class="room-stops" id="room-stops" aria-label="Site" style="opacity:0">
    {STOPS.map((s) => (
      <a href={s.href} aria-current={s.href === current ? 'page' : undefined}>{s.label}</a>
    ))}
  </nav>
  <div class="room-line" aria-hidden="true">
    <span class="comet"></span>
    <span class="comet"></span>
    <span class="comet"></span>
    <span class="comet"></span>
    <span class="comet"></span>
  </div>
</header>

<script is:inline>
  // A room is outside the show. Coming back to the field should meet
  // "unroll the logic" again, not the already-docked field. Cleared
  // here so the next load of / plays the nerve drop and the opening.
  try { sessionStorage.removeItem('sopalda-docked'); } catch (e) {}
</script>
<script>
  // Field.astro sets this on the way out. A direct visit has no flag,
  // so the rail is simply already there — no fake entrance.
  const rail = document.querySelector('.room-nerve');
  if (rail && sessionStorage.getItem('sopalda-arrive') === location.pathname) {
    rail.setAttribute('data-arrive', '1');
    sessionStorage.removeItem('sopalda-arrive');
  }
  const stops = document.getElementById('room-stops');
  function riseMenu() {
    if (!stops) return;
    stops.style.transition = 'opacity 2.8s cubic-bezier(.22, .7, .2, 1)';
    requestAnimationFrame(() => { stops.style.opacity = '1'; });
  }
  window.addEventListener('pagereveal', (event) => {
    const transition = event.viewTransition;
    if (transition) transition.finished.then(() => window.setTimeout(riseMenu, 400));
    else window.setTimeout(riseMenu, 400);
  });
  window.setTimeout(riseMenu, 1200);
  const toggle = document.querySelector('.menu-toggle');
  const line = document.querySelector('.room-line');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let y = 0;
  let v = 0;
  let rest = 0;
  let running = false;
  let last = 0;
  const OMEGA = 2.6;

  function travel() {
    const dropPx = window.innerHeight * 0.28;
    rest = document.querySelector('.room-nerve')?.classList.contains('is-dropped') ? dropPx : 0;
    if (reduced) {
      y = rest;
      v = 0;
      if (line) line.style.transform = `translateY(${y}px)`;
      return;
    }
    if (!running) {
      running = true;
      last = performance.now();
      requestAnimationFrame(step);
    }
  }

  function step(now) {
    const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
    last = now;
    const A = y - rest;
    const B = v + OMEGA * A;
    const decay = Math.exp(-OMEGA * dt);
    y = rest + (A + B * dt) * decay;
    v = (B - OMEGA * (A + B * dt)) * decay;
    if (line) line.style.transform = `translate3d(0, ${y}px, 0)`;
    if (Math.abs(y - rest) < 0.2 && Math.abs(v) < 0.2) {
      y = rest;
      v = 0;
      running = false;
      if (line) line.style.transform = `translate3d(0, ${y}px, 0)`;
      if (rest === 0 && stops) stops.style.opacity = '1';
      return;
    }
    requestAnimationFrame(step);
  }

  toggle?.addEventListener('click', () => {
    const rail = document.querySelector('.room-nerve');
    if (!rail || !toggle || !line) return;
    if (stops) {
      stops.style.transition = 'opacity 0.6s ease';
      stops.style.opacity = '0';
    }
    toggle.style.transition = 'opacity 0.6s ease';
    toggle.style.opacity = '0';
    toggle.style.pointerEvents = 'none';
    window.setTimeout(() => {
      try {
        sessionStorage.setItem('sopalda-docked', '1');
        sessionStorage.setItem('sopalda-return', '1');
      } catch (e) {}
      location.href = '/';
    }, reduced ? 1 : 700);
  });
</script>

<style>
  .room-nerve {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    height: calc(var(--nerve-dock) + 2.6rem);
    overflow: visible;
    pointer-events: none;
    font-family: var(--font-mono);
  }

  .room-home,
  .menu-toggle,
  .room-stops a,
  .mark {
    pointer-events: auto;
  }

  .menu-toggle {
    position: absolute;
    top: calc(82px + env(safe-area-inset-top));
    left: 1.4rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-toggle:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
  }

  /* Same lockup as the docked field wordmark: given name tall,
     surname round, tagline in mono. Upper right, above the nerve. */
  .mark {
    position: fixed;
    top: calc(42px + env(safe-area-inset-top));
    right: 28px;
    left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 0;
    text-align: right;
    text-decoration: none;
    z-index: 30;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    margin: 0;
    line-height: 0.88;
  }

  .given,
  .family {
    white-space: nowrap;
  }

  .given {
    font-family: var(--font-wordmark-given);
    font-weight: 400;
    font-size: clamp(.95rem, 3.1vw, 1.2rem);
    letter-spacing: .1em;
    color: var(--bronze);
  }

  .family {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: clamp(1.28rem, 4.1vw, 1.65rem);
    letter-spacing: 0;
    color: var(--flesh);
  }

  .tagline {
    display: inline-block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: .52rem;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
    text-align: right;
    white-space: nowrap;
    color: var(--champagne);
  }

  .tagline .amp {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2em;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0.85;
  }

  .mark:hover .family,
  .mark:focus-visible .family {
    color: var(--gold);
  }

  .room-home:focus-visible,
  .room-stops a:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .room-plate {
    position: absolute;
    top: calc(12px + env(safe-area-inset-top));
    right: 28px;
    margin: 0;
    text-align: right;
    font-weight: 400;
  }

  .room-plate-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: rgba(243, 235, 224, 0.55);
  }

  .room-plate-name {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-display, 'Fraunces', serif);
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--bone);
  }

  /* Same Y Field.astro eases the flattened nerve toward. Named so the
     cross-document view transition (global.css) can hand this line
     off instead of crossfading the whole scene into a bar. */
  .room-line {
    view-transition-name: nerve-rail;
    position: fixed;
    top: var(--nerve-dock);
    left: 0;
    right: 0;
    height: 1px;
    overflow: visible;
    pointer-events: none;
    background: rgba(247, 197, 106, 0.9);
    box-shadow: 0 0 6px rgba(247, 197, 106, 0.45);
    will-change: transform;
  }

  .comet {
    position: absolute;
    top: -2px;
    width: 130px;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(90deg, rgba(255, 255, 240, 0), rgba(255, 250, 220, 0.5) 60%, rgba(255, 255, 245, 1));
    filter: drop-shadow(0 0 6px rgba(255, 255, 235, 0.9));
    animation: comet-run linear infinite;
    pointer-events: none;
  }

  .comet::after {
    content: "";
    position: absolute;
    right: -3px;
    top: -1px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 250, 1);
    box-shadow: 0 0 10px 2px rgba(255, 255, 235, 0.95);
  }

  /* Same five pulses as the field: speed 0.055, 0.08, 0.038, 0.067, 0.046
     of the width per second, phases 0.1, 0.62, 0.35, 0.82, 0.5. */
  .comet:nth-child(1) { animation-duration: 18.2s; animation-delay: -1.8s; }
  .comet:nth-child(2) { animation-duration: 12.5s; animation-delay: -7.8s; }
  .comet:nth-child(3) { animation-duration: 26.3s; animation-delay: -9.2s; }
  .comet:nth-child(4) { animation-duration: 14.9s; animation-delay: -12.2s; }
  .comet:nth-child(5) { animation-duration: 21.7s; animation-delay: -10.9s; }

  @keyframes comet-run {
    from { transform: translateX(-140px); }
    to { transform: translateX(100vw); }
  }

  .room-stops {
    position: absolute;
    top: calc(86px + env(safe-area-inset-top));
    left: 6.4rem;
    right: 13rem;
    display: flex;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 1.35rem;
  }

  .room-nerve.is-dropped .room-stops {
    pointer-events: none;
  }

  .room-stops a {
    color: rgba(247, 197, 106, 0.45);
    text-decoration: none;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .room-stops a:hover,
  .room-stops a:focus-visible,
  .room-stops a[aria-current='page'] {
    color: var(--bronze);
  }

  @media (max-width: 720px) {
    .room-stops {
      left: 0.6rem;
      right: 0.6rem;
      overflow-x: auto;
      justify-content: flex-start;
      gap: 0.85rem;
      -webkit-overflow-scrolling: touch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .comet {
      animation: none;
      opacity: 0;
    }
    .room-stops {
      animation: none;
      opacity: 1;
    }
  }
</style>
