    // which needs X values the drift step below -- earlier in the same
    // frame -- hasn't computed yet) and read by NEXT frame's drift
    // step: a one-frame lag, same trade the fragment dodge logic
    // elsewhere in this file already makes for the same reason.
    let anyStopNear = false;
    let worldX = 0, targetX = 0, worldYoff = 0, dragY = 0;
    let drag = false, lastX = 0, lastY = 0;
    // Act II -> Act III departure: clicking a stop used to navigate the
    // instant the <a> fired, a hard cut with no acknowledgment that the
    // nerve itself heard the choice. Now the click is caught, the world
    // pans so the chosen stop settles at screen center -- "the nerve
    // looking for its new position" -- and only once that eased glide
    // finishes does the real navigation happen. DEPART_MS is a fixed,
    // known duration (not a chase that only asymptotically arrives) for
    // exactly that reason: something has to trigger the actual
    // navigation at a definite moment. departEl (not the whole node) is
    // enough to let the stops loop recognise which stop is departing.
    const DEPART_FLATTEN_MS = 900;
    const DEPART_RISE_MS = 2400;
    const DEPART_SETTLE_MS = 500;
    const DEPART_MS = DEPART_FLATTEN_MS + DEPART_RISE_MS + DEPART_SETTLE_MS;
    let departing = false;
    let departStartT = 0;
    let departFromX = 0;
    let departToX = 0;
    let departHref = '';
    let departEl: HTMLAnchorElement | null = null;
    // The nerve straightening on the way out, in the same window --
    // not a second animation system next to the pan above, the same
    // eased progress drives both. straightenAmt is nerveBaseY's own
    // amplitude/spring multiplier: 1 at the click (full wave, nothing
    // changes yet), eased to 0 by the time DEPART_MS is up (dead flat).
    // departNerveFrom/To are captured once, at the click, the same way
    // departFromX/departToX are -- not recomputed every frame, so a
    // resize or a stray layout thrash mid-glide can't retarget where
    // the line is headed. The target itself is wherever the wordmark's
    // OWN docked position already is (body.is-docked .mark, measured
    // directly, not a second hand-tuned guess at the same spot) -- the
    // flattened nerve settles into the same corner the wordmark
    // already claimed on the way into the field, not a new resting
    // place invented for this.
    let straightenAmt = 1;
    // 1 while the field is drifting, eased toward ~0.28 while a stop
    // is held. Multiplies nerveBaseY's amplitude only — breath and the
    // pulses stay. A full freeze reads as a crash.
    let calmAmt = 1;
    let holdAmt = 0;
    const fromRoom = sessionStorage.getItem('sopalda-nerve') === '1';
    if (fromRoom && railEl) {
      railEl.style.opacity = '1';
      sessionStorage.removeItem('sopalda-nerve');
    }
    let departNerveFromMin = 0;
    let departNerveFromMax = 0;
    let departNerveToMin = 0;
    let departNerveToMax = 0;
    // Real elapsed time, not frame count -- frame() below used to run
    // dt as a hardcoded 1/60 regardless of how often the browser
    // actually called it, so on a 120Hz display (most current-gen
    // phones, ProMotion iPhones included) the whole field -- drift,
    // nerve springs, specimen lean/wake, flare cycles, how long a
    // fragment holds before decaying -- ran at up to double intended
    // speed, since requestAnimationFrame simply fires twice as often
    // there. Verified directly: simulating 120Hz vs 60Hz produced 27%
    // more real drift distance over the same 5 real seconds (worse for
    // anything with no smoothing, like the flare timers). The letter-
    // scatter decay physics (stepPhysFor below) already measured real
    // time via performance.now(); this brings the outer loop in line
    // with that same, already-proven pattern. Capped at 50ms per step
    // (20fps floor) so a lagged frame or a backgrounded-tab catch-up
    // frame doesn't jump everything forward in one leap -- rAF itself
    // already stops firing on a hidden tab in every real browser, so
    // this cap is what keeps that return frame from being read as
    // "50 seconds passed," which functionally satisfies FIELD-SPEC's
    // "pause the clock when backgrounded" without a separate listener.
    let lastFrameTime = 0;
