---
// A local, textual echo of the field's own nerve -- not the canvas
// system itself (that would be a strange, heavy thing to import into a
// plain reading room), just its typographic vocabulary (mono, tracked,
// gold-for-awake) applied to a real filter: six threads plus "Archive"
// (everything, unfiltered), each a real <a>, so this works with
// JavaScript off exactly the same as with it on -- there's no client
// state here, "active" is just whichever real page you're already on.
// Shared by /writing (active=null, meaning Archive) and each
// /thread/[name] page (active=that thread), so the same seven links,
// in the same order, render identically everywhere they appear.
import { THREADS } from '../data/threads';

interface Props {
  active?: string | null;
}
const { active = null } = Astro.props;
---

<nav class="thread-nerve" aria-label="Filter writing by thread">
  <ol>
    <li>
      <a href="/writing" aria-current={active === null ? 'page' : undefined}>Archive</a>
    </li>
    {THREADS.map((t) => (
      <li>
        <a href={`/thread/${t.toLowerCase()}`} aria-current={active === t ? 'page' : undefined}>{t}</a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .thread-nerve {
    position: fixed;
    left: calc(1.75rem + 17rem + 6.5rem + max(0px, (100vw - 1.75rem - 17rem - 6.5rem - 7rem - 54rem) / 2));
    width: min(54rem, calc(100vw - 1.75rem - 17rem - 6.5rem - 7rem));
    right: auto;
    bottom: 0;
    z-index: 16;
    margin: 0;
    padding: 1.2rem 0 1rem;
    background: var(--void);
    pointer-events: none;
  }

  .thread-nerve ol {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0;
    white-space: nowrap;
    border-top: 1px solid rgba(227, 175, 149, 0.28);
    pointer-events: auto;
  }

  .thread-nerve li {
    display: flex;
    align-items: center;
  }

  .thread-nerve li + li::before {
    content: "|";
    margin: 0 0.7rem;
    color: rgba(227, 175, 149, 0.45);
  }

  .thread-nerve a {
    /* Direct feedback: "is not easy to click in the options of the
       nerve." The link itself was bare text with zero padding -- at
       0.65rem mono, the real hit box was only a few pixels tall, well
       under any reasonable tap target. display:block + padding gives
       it one; the negative margin cancels the padding back out of the
       flex gap so the row's own spacing and wrap behaviour read
       exactly as before -- only the invisible clickable area grew. */
    display: block;
    padding: 0.4em 0.3em;
    margin: -0.4em -0.3em;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(227, 175, 149, 0.55);
    /* Same grammar as the field's own .stop approach state (Field.astro:
       "the bead brightens, the label rises and letterspaces," FIELD-
       SPEC.md) -- borrowed deliberately rather than the field's full
       flatten-and-rise departure move, which is reserved for crossing
       an actual room threshold, not a frequent in-page filter click.
       Scaled down to this nav's own proportions: no halo-grade glow,
       no 600-weight jump, just the same three ingredients at a size
       that fits one thin filter row instead of the real navigation. */
    transform: scale(1);
    transition:
      color 0.5s,
      letter-spacing 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      text-shadow 0.5s;
  }

  .thread-nerve a:hover,
  .thread-nerve a:focus-visible {
    color: var(--gold);
    letter-spacing: 0.22em;
    transform: scale(1.16);
    text-shadow: 0 0 8px rgba(247, 197, 106, 0.45);
  }

  /* The one thread actually being read right now -- gold, same as
     whatever else on this site is "awake" (non-negotiable 6), not a
     second resting colour invented for this one nav. */
  .thread-nerve a[aria-current='page'] {
    color: var(--gold);
  }

  .thread-nerve a:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    .thread-nerve {
      left: 1.5rem;
      right: 1.5rem;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thread-nerve a {
      transition: color 0.5s;
    }

    .thread-nerve a:hover,
    .thread-nerve a:focus-visible {
      letter-spacing: 0.14em;
      transform: scale(1);
    }
  }
</style>
