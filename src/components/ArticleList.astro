---
// Archive rows for /writing and each /thread/[name] page. The plate is
// the article's own illustration when front matter has one, and the
// catalogue number when it does not — never a borrowed image. Text
// stays the row. The picture sits on void, contained, the way a
// specimen sits in the field, not cropped into a card.
export interface ArticleRow {
  id: string;
  title: string;
  date: Date;
  kind: string;
  threads: string[];
  no: number | null;
  lead: string | null;
  dek?: string | null;
  image?: string | null;
}

interface Props {
  entries: ArticleRow[];
}

const { entries } = Astro.props;

const months = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

const years = [...new Set(entries.map((a) => a.date.getFullYear()))];

function stamp(d: Date) {
  return `${d.getDate()} ${months[d.getMonth()]}`;
}
---

{
  years.map((year) => {
    const rows = entries.filter((a) => a.date.getFullYear() === year);
    return (
      <section class="year">
        <h2>{year}</h2>
        <ol class="list">
          {rows.map((a, i) => (
            <li style={`animation-delay: ${Math.min(i, 12) * 40}ms`}>
              <a class="row" href={`/writing/${a.id}`}>
                <span class="plate">
                  {a.image ? (
                    <img src={a.image} alt="" />
                  ) : (
                    <span class="index">{a.no ? String(a.no).padStart(2, '0') : '—'}</span>
                  )}
                </span>
                <span class="copy">
                  <span class="meta">
                    {stamp(a.date)} · {a.kind}
                    {a.no ? ` · No.${String(a.no).padStart(2, '0')}` : ''}
                  </span>
                  <span class="title">{a.title}</span>
                  {(a.dek || a.lead) && <span class="lead">{a.dek || a.lead}</span>}
                  {a.threads[0] && <span class="thread">{a.threads[0]}</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })
}

<style>
  .year {
    margin-top: 2.75rem;
  }

  .year h2 {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: rgba(247, 197, 106, 0.7);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list li {
    border-top: 1px solid rgba(243, 235, 224, 0.12);
    clip-path: inset(0 0 100% 0);
    animation: row-print 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  .list li:last-child {
    border-bottom: 1px solid rgba(243, 235, 224, 0.12);
  }

  @keyframes row-print {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0.4;
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .list li {
      clip-path: none;
      animation: none;
    }
  }

  .row {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1rem 0;
    text-decoration: none;
    color: inherit;
  }

  .row:hover .title,
  .row:focus-visible .title {
    color: var(--gold);
  }

  .row:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
  }

  /* The illustration is a specimen, not a thumbnail. Void ground,
     contained, so a figure is never cropped to fill a box. Pieces
     without a plate keep the catalogue number in the same slot, so
     the column doesn't collapse. */
  .plate {
    width: 9.5rem;
    height: 6.4rem;
    display: grid;
    place-items: center;
    background: #070707;
    border: 1px solid rgba(243, 235, 224, 0.14);
  }

  .plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0.84) contrast(1.08) saturate(0.92);
    transition: filter 0.7s var(--ease);
  }

  .row:hover .plate img,
  .row:focus-visible .plate img {
    filter: brightness(1) contrast(1.05) saturate(1);
  }

  .index {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: rgba(247, 197, 106, 0.55);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    min-width: 0;
  }

  .meta,
  .thread {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 235, 224, 0.42);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.25;
    transition: color 0.4s var(--ease);
  }

  .lead {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--oxide-lit);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 6.4rem 1fr;
      gap: 0.8rem;
    }

    .plate {
      width: 6.4rem;
      height: 4.4rem;
    }
  }
</style>
