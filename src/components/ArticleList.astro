---
// The archive is a contents page. Date in the margin, the title on a
// readable measure, the thread closing the line on the right.
export interface ArticleRow {
  id: string;
  title: string;
  date: Date;
  kind: string;
  threads: string[];
  no: number | null;
  lead: string | null;
  dek?: string | null;
  image?: string | null;
}

interface Props {
  entries: ArticleRow[];
}

const { entries } = Astro.props;

const years = [...new Set(entries.map((a) => a.date.getFullYear()))];

function stamp(d: Date) {
  return `${String(d.getDate()).padStart(2, '0')} / ${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---

{
  years.map((year) => {
    const rows = entries.filter((a) => a.date.getFullYear() === year);
    return (
      <section class="archive">
        <h2>{year}</h2>
        <ol class="list">
          {rows.map((a) => (
            <li>
              <a class="row" href={`/writing/${a.id}`}>
                <span class="meta">{stamp(a.date)}</span>
                <span class="plate">
                  {a.image ? (
                    <img src={a.image} alt="" />
                  ) : (
                    <span class="index">{a.no ? String(a.no).padStart(2, '0') : ''}</span>
                  )}
                </span>
                <span class="copy">
                  <span class="title">{a.title}</span>
                  {(a.dek || a.lead) && <span class="lead">{a.dek || a.lead}</span>}
                </span>
                {a.threads[0] && <span class="thread">{a.threads[0]}</span>}
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })
}

<style>
  .archive {
    margin-top: 3.4rem;
  }

  .archive h2 {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.45rem;
    letter-spacing: 0.04em;
    color: var(--bronze);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list li {
    border-top: 1px solid rgba(243, 235, 224, 0.14);
  }

  .list li:last-child {
    border-bottom: 1px solid rgba(243, 235, 224, 0.14);
  }

  .row {
    display: grid;
    grid-template-columns: 4.2rem 4.6rem minmax(0, 1fr) auto;
    column-gap: 1.6rem;
    align-items: center;
    padding: 1.05rem 0;
    text-decoration: none;
    color: inherit;
  }

  .row:hover .title,
  .row:focus-visible .title {
    color: var(--gold);
  }

  .meta {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--champagne);
  }

  .plate {
    width: 4.6rem;
    height: 5.8rem;
    display: grid;
    place-items: center;
    background: #070707;
    border: 1px solid rgba(170, 104, 66, 0.4);
    overflow: hidden;
  }

  .plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .index {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--bronze);
  }

  .copy {
    min-width: 0;
    padding-right: 2rem;
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.8vw, 1.85rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--bone);
  }

  .lead {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.02rem;
    line-height: 1.4;
    color: var(--flesh);
  }

  .thread {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--champagne);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 3.4rem 1fr auto;
      row-gap: 0.35rem;
    }

    .plate {
      grid-row: 1 / span 2;
      width: 3.4rem;
      height: 4.4rem;
    }

    .meta {
      grid-column: 2 / -1;
    }

    .copy {
      grid-column: 2;
      padding-right: 0;
    }
  }
</style>
