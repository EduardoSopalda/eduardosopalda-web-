---
// The archive is a contents page. The plate belongs to the current
// note, not to every row. Date in the margin, title on the line, lead
// under it, a rule the full measure.
export interface ArticleRow {
  id: string;
  title: string;
  date: Date;
  kind: string;
  threads: string[];
  no: number | null;
  lead: string | null;
  dek?: string | null;
  image?: string | null;
}

interface Props {
  entries: ArticleRow[];
}

const { entries } = Astro.props;

const years = [...new Set(entries.map((a) => a.date.getFullYear()))];

function stamp(d: Date) {
  return `${String(d.getDate()).padStart(2, '0')} / ${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---

{
  years.map((year) => {
    const rows = entries.filter((a) => a.date.getFullYear() === year);
    return (
      <section class="year">
        <h2>{year}</h2>
        <ol class="list">
          {rows.map((a) => (
            <li>
              <a class="row" href={`/writing/${a.id}`}>
                <span class="meta">{stamp(a.date)}</span>
                <span class="copy">
                  <span class="title">{a.title}</span>
                  {(a.dek || a.lead) && <span class="lead">{a.dek || a.lead}</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })
}

<style>
  .year {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2.8rem;
  }

  .year h2 {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.35rem;
    color: var(--bronze);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list li {
    border-top: 1px solid rgba(243, 235, 224, 0.14);
  }

  .list li:last-child {
    border-bottom: 1px solid rgba(243, 235, 224, 0.14);
  }

  .row {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: 1.4rem;
    align-items: baseline;
    padding: 1.15rem 0;
    text-decoration: none;
    color: inherit;
  }

  .row:hover .title,
  .row:focus-visible .title {
    color: var(--gold);
  }

  .meta {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--champagne);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--bone);
  }

  .lead {
    max-width: 40rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--flesh);
  }

  @media (max-width: 640px) {
    .year,
    .row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
