---
// Archive rows for /writing and each /thread/[name] page. The plate is
// the article's own illustration when front matter has one, and the
// catalogue number when it does not — never a borrowed image. Text
// stays the row. The picture sits on void, contained, the way a
// specimen sits in the field, not cropped into a card.
export interface ArticleRow {
  id: string;
  title: string;
  date: Date;
  kind: string;
  threads: string[];
  no: number | null;
  lead: string | null;
  dek?: string | null;
  image?: string | null;
}

interface Props {
  entries: ArticleRow[];
}

const { entries } = Astro.props;

const months = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

const years = [...new Set(entries.map((a) => a.date.getFullYear()))];

function stamp(d: Date) {
  return `${String(d.getDate()).padStart(2, '0')} / ${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---

{
  years.map((year) => {
    const rows = entries.filter((a) => a.date.getFullYear() === year);
    return (
      <section class="year">
        <h2>{year}</h2>
        <ol class="list">
          {rows.map((a, i) => (
            <li style={`animation-delay: ${Math.min(i, 12) * 40}ms`}>
              <a class="row" href={`/writing/${a.id}`}>
                <span class="plate">
                  {a.image ? (
                    <img src={a.image} alt="" />
                  ) : (
                    <span class="index">{a.no ? String(a.no).padStart(2, '0') : '—'}</span>
                  )}
                </span>
                <span class="copy">
                  <span class="meta">{stamp(a.date)}</span>
                  <span class="title">{a.title}</span>
                  {(a.dek || a.lead) && <span class="lead">{a.dek || a.lead}</span>}
                  <span class="more">Continue</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })
}

<style>
  .year {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 2rem;
    margin-top: 3.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(170, 104, 66, 0.45);
  }

  .year h2 {
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--bronze);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list li {
    border-top: 1px solid rgba(243, 235, 224, 0.12);
    clip-path: inset(0 0 100% 0);
    animation: row-print 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  .list li:last-child {
    border-bottom: 1px solid rgba(243, 235, 224, 0.12);
  }

  @keyframes row-print {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0.4;
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .list li {
      clip-path: none;
      animation: none;
    }
  }

  .row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
    padding: 1.4rem 0;
    text-decoration: none;
    color: inherit;
  }

  .row:hover .title,
  .row:focus-visible .title {
    color: var(--gold);
  }

  .row:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
  }

  /* The illustration is a specimen, not a thumbnail. Void ground,
     contained, so a figure is never cropped to fill a box. Pieces
     without a plate keep the catalogue number in the same slot, so
     the column doesn't collapse. */
  .plate {
    width: 8.5rem;
    height: 5.6rem;
    display: grid;
    place-items: center;
    background: #070707;
    border: 1px solid rgba(170, 104, 66, 0.4);
    overflow: hidden;
  }

  .plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    filter: brightness(0.9) saturate(0.9);
    transition: filter 0.7s var(--ease);
  }

  .row:hover .plate img,
  .row:focus-visible .plate img {
    filter: brightness(1) contrast(1.05) saturate(1);
  }

  .index {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: rgba(247, 197, 106, 0.55);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    min-width: 0;
  }

  .meta {
    padding-top: 0.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--champagne);
  }

  .title {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--bone);
    transition: color 0.4s var(--ease);
  }

  .lead {
    max-width: 38rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--flesh);
  }

  .more {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--flesh);
  }

  .more::after {
    content: " →";
  }

  @media (max-width: 640px) {
    .year {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .row {
      grid-template-columns: 7.2rem 1fr;
      gap: 0.8rem;
    }

    .meta {
      grid-column: 2;
    }

    .plate {
      width: 7.2rem;
      height: 4.8rem;
      grid-row: 1 / span 3;
    }
  }
</style>
