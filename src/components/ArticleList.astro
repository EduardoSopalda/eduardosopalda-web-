---
// The archive is a contents page. Date in the margin, the title on a
// readable measure, the thread closing the line on the right.
export interface ArticleRow {
  id: string;
  title: string;
  date: Date;
  kind: string;
  threads: string[];
  no: number | null;
  lead: string | null;
  dek?: string | null;
  image?: string | null;
}

interface Props {
  entries: ArticleRow[];
}

const { entries } = Astro.props;

const years = [...new Set(entries.map((a) => a.date.getFullYear()))];

function stamp(d: Date) {
  return `${String(d.getDate()).padStart(2, '0')} / ${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---

{
  years.map((year) => {
    const rows = entries.filter((a) => a.date.getFullYear() === year);
    return (
      <section class="year">
        <h2>{year}</h2>
        <ol class="list">
          {rows.map((a) => (
            <li>
              <a class="row" href={`/writing/${a.id}`}>
                <span class="meta">{stamp(a.date)}</span>
                <span class="copy">
                  <span class="title">{a.title}</span>
                  {(a.dek || a.lead) && <span class="lead">{a.dek || a.lead}</span>}
                </span>
                {a.threads[0] && <span class="thread">{a.threads[0]}</span>}
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })
}

<style>
  .year {
    margin-top: 3.4rem;
  }

  .year h2 {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.45rem;
    letter-spacing: 0.04em;
    color: var(--bronze);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list li {
    border-top: 1px solid rgba(243, 235, 224, 0.14);
  }

  .list li:last-child {
    border-bottom: 1px solid rgba(243, 235, 224, 0.14);
  }

  .row {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr) auto;
    column-gap: 2rem;
    align-items: start;
    padding: 1.35rem 0 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .row:hover .title,
  .row:focus-visible .title {
    color: var(--gold);
  }

  .meta {
    padding-top: 0.55rem;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--champagne);
  }

  .copy {
    min-width: 0;
  }

  .title {
    display: block;
    max-width: 22em;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.3vw, 2.15rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--bone);
  }

  .lead {
    display: block;
    max-width: 38rem;
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--flesh);
  }

  .thread {
    padding-top: 0.7rem;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--champagne);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr auto;
      row-gap: 0.35rem;
    }

    .meta {
      grid-column: 1 / -1;
      padding-top: 0;
    }

    .thread {
      padding-top: 0.15rem;
    }
  }
</style>
